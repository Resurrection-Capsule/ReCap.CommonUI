<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:rcui="https://github.com/Resurrection-Capsule/ReCap.CommonUI"
		xmlns:demo="using:ReCap.CommonUI.Demo"
		xmlns:vps="using:ReCap.CommonUI.Demo.Views.Pages.Styles"
		xmlns:st="using:Sortable.Avalonia">
	<Styles.Resources>
		<GradientStops x:Key="FakeTitleBarFadeStops">
			<GradientStop Offset="0" Color="#FFFFFFFF" />
			<GradientStop Offset="1" Color="#00FFFFFF" />
		</GradientStops>


		<ControlTheme x:Key="FakeTitleBarPartBase"
				  	TargetType="{x:Type ContentControl}">
			<Setter Property="HorizontalAlignment" Value="Stretch" />

			<Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderBrush" Value="Transparent" />
				<Setter Property="BorderThickness" Value="0" />
				<Setter Property="Content" Value="{TemplateBinding Content}" />
				<Setter Property="ContentTemplate" Value="{TemplateBinding ContentTemplate}" />
				<Setter Property="Foreground" Value="{TemplateBinding Foreground}" />
				<Setter Property="HorizontalContentAlignment" Value="{TemplateBinding HorizontalContentAlignment}" />
				<Setter Property="VerticalContentAlignment" Value="{TemplateBinding VerticalContentAlignment}" />
			</Style>
		</ControlTheme>


		<ControlTheme x:Key="FakeTitleBarContainer"
				  	TargetType="{x:Type ContentControl}"
					BasedOn="{StaticResource FakeTitleBarPartBase}">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="ClipToBounds" Value="False" />
			<Setter Property="Template">
				<ControlTemplate>
					<DockPanel x:Name="FakeBgContainer">
					<!--
							Classes.IsWindowActive="{Binding Path=IsActive, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}, Mode=OneWay, FallbackValue=True}"
					-->
							<Panel ClipToBounds="True"
								DockPanel.Dock="Bottom">
								<Panel.OpacityMask>
									<LinearGradientBrush StartPoint="0%,6.25%"
														EndPoint="0%,87.5%"
														GradientStops="{DynamicResource FakeTitleBarFadeStops}" />
								</Panel.OpacityMask>
								<Panel Margin="0,0,4,0">
									<rcui:AngledBorder Classes="holo-shadow"
													CornerRadius="0,0,9,9"
													Margin="0,-4,0,0">
										<!--
										<rcui:AngledBorder.OpacityMask>
											<LinearGradientBrush StartPoint="0%,56.25%"
																EndPoint="0%,100%"
																GradientStops="{DynamicResource FakeTitleBarFadeStops}" />
										</rcui:AngledBorder.OpacityMask>
										-->
									</rcui:AngledBorder>
								</Panel>
								<rcui:AngledBorderEx x:Name="BgElement"
													TopLeftCut="6"
													TopRightCut="6"
													TopLeftInset="18"
													TopRightInset="18"
													Background="{DynamicResource Window.Body.Background}"
													BorderBrush="{DynamicResource Window.Body.BorderBrush}"
													StrokeThickness="1"
													InnerGlowColor="{DynamicResource Window.Body.InnerGlowColor}"
													Margin="0,2,4,0"
													MinHeight="32">
								<!--
													BottomRightCut="6"
													BottomLeftCut="6"

													BottomRightInset="18"
													BottomLeftInset="18"
								-->
								</rcui:AngledBorderEx>
							</Panel>
						<Panel>
							<Panel ClipToBounds="True"
								Margin="0,2,4,0">
								<rcui:AngledBorder Classes="holo-shadow"
												CornerRadius="9,9,0,0"
												Margin="0,0,0,-4" />
							</Panel>
							<ContentPresenter x:Name="PART_ContentPresenter"
											Height="{DynamicResource Window.TitleBar.ReservedHeight}"
											ClipToBounds="False" />
						</Panel>
					</DockPanel>
				</ControlTemplate>
			</Setter>
			<Style Selector="^ /template/ rcui|AngledBorder.holo-shadow">
				<Setter Property="Background" Value="{DynamicResource Window.HoloShadow.Background.Translucent}" />
				<Setter Property="BorderBrush" Value="{DynamicResource Window.HoloShadow.BorderBrush.Translucent}" />
				<Setter Property="StrokeThickness" Value="2" />
			</Style>

		    <!--
			<Style Selector="^ /template/ DockPanel#FakeBgContainer:not(.IsWindowActive)">
			-->
			<Style Selector="Window[IsActive=False] ^">
				<Style Selector="^ /template/ rcui|AngledBorder.holo-shadow">
					<Setter Property="Opacity" Value="0.5" />
				</Style>
		    </Style>
		</ControlTheme>


		<ControlTheme x:Key="FakeTitleBarMiddle"
				  	TargetType="{x:Type ContentControl}"
					BasedOn="{StaticResource FakeTitleBarPartBase}">
			<Setter Property="VerticalAlignment" Value="Stretch" />
			<Setter Property="Padding" Value="9,0" />
			<!--
			-->
			<Setter Property="ClipToBounds" Value="False" />
			<Setter Property="Template">
				<ControlTemplate>
					<Panel>
						<!--
						<rcui:AngledBorderEx x:Name="TitleBarBackground"
											Classes.IsWindowActive="{Binding Path=IsActive, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}, Mode=OneWay, FallbackValue=True}"
											BorderBrush="{DynamicResource Window.TitleBar.BorderBrush}"
											StrokeThickness="1"
											IsHitTestVisible="False"
											TopLeftCut="6"
											TopRightCut="31"
											BottomLeftInset="18"
											BottomLeftCut="6"
											InvertSide="Bottom"
											Margin="0,0,0,-5" />
						-->
						<rcui:TitleBarAngledBorder x:Name="TitleBarBackground"
												TopLeftInset="{TemplateBinding Tag, Converter={x:Static rcui:ThicknessToDoubleConverters.Left}, Mode=OneWay}"
												TopRightInset="{TemplateBinding Tag, Converter={x:Static rcui:ThicknessToDoubleConverters.Right}, Mode=OneWay}"
												Margin="0,0,0,-5" />

						<ContentPresenter x:Name="PART_ContentPresenter"
										Margin="{TemplateBinding Tag}"
										Padding="{TemplateBinding Padding}" />
						<!--
										Padding="9,0" />
						-->
					</Panel>
				</ControlTemplate>
			</Setter>


			<!--
			<Style Selector="^ /template/ :is(rcui|AngledBorderBase)#TitleBarBackground:not(.IsWindowActive)">
				<Setter Property="Background" Value="{DynamicResource Window.TitleBar.BackgroundBrush.Inactive}" />
			</Style>

			<Style Selector="^ /template/ :is(rcui|AngledBorderBase)#TitleBarBackground.IsWindowActive">
				<Setter Property="Background" Value="{DynamicResource Window.TitleBar.BackgroundBrush.Active}" />
			</Style>
			-->
		</ControlTheme>


		<ControlTheme x:Key="FakeTitleBarText"
				  	TargetType="{x:Type TextBlock}">
			<Setter Property="FontFamily" Value="{DynamicResource HeaderFont}" />
			<Setter Property="FontSize" Value="15" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</ControlTheme>


		<ControlTheme x:Key="CaptionButtonRolesBase"
				  	TargetType="{x:Type ItemsControl}"
					BasedOn="{StaticResource {x:Type ItemsControl}}">
			<Setter Property="MinWidth" Value="60" />
			<Setter Property="Padding" Value="0,8,0,0" />

			<Setter Property="st:Sortable.Group" Value="CaptionButtonsRoles" />
			<Setter Property="ItemsPanel">
				<ItemsPanelTemplate>
					<StackPanel x:Name="PART_ItemsPanel"
								Orientation="Horizontal"
								Spacing="2" />
				</ItemsPanelTemplate>
			</Setter>

			<Style Selector="^[(DockPanel.Dock)=Left]">
				<Setter Property="HorizontalAlignment" Value="Left" />
				<Setter Property="Margin" Value="9,0,0,0" />

				<Style Selector="^[(DockPanel.Dock)=Left] > :is(TemplatedControl) /template/ rcui|CaptionButton#CaptionButton">
					<Setter Property="CornerRadius" Value="5,0,5,0" />
				</Style>
			</Style>
		</ControlTheme>

		<ControlTheme x:Key="CaptionButtonsSide"
				  	TargetType="{x:Type ItemsControl}"
					BasedOn="{StaticResource CaptionButtonRolesBase}">
			<Setter Property="st:Sortable.Droppable" Value="True" />
			<Setter Property="st:Sortable.Sortable" Value="True" />

			<Setter Property="st:Sortable.DropCommand" Value="{Binding CBSideDropCommand, Mode=OneWay}" />
			<Setter Property="st:Sortable.UpdateCommand" Value="{Binding CBSideUpdateCommand, Mode=OneWay}" />
			<Setter Property="st:Sortable.ReleaseCommand" Value="{Binding CBSideReleaseCommand, Mode=OneWay}" />

			<Setter Property="ItemTemplate">
				<DataTemplate>
					<Panel x:Name="ItemLayoutRoot"
						Background="#01000000"
						st:Sortable.IsSortable="True"
						st:Sortable.IsDroppable="True">
						<rcui:CaptionButton x:Name="CaptionButton"
											Classes="FakeCaptionButton"
											ToolTip.Tip="{Binding Mode=OneWay}">
							<TemplatedControl Theme="{DynamicResource CaptionButtonCluster.GlyphPresenter}"
											DataContext="{Binding Mode=OneWay}" />
						</rcui:CaptionButton>
					</Panel>
				</DataTemplate>
			</Setter>

			<Style Selector="^[(DockPanel.Dock)=Right]">
				<Setter Property="HorizontalAlignment" Value="Right" />
				<Setter Property="Margin" Value="0,0,9,0" />
			</Style>

			<Style Selector="^:empty">
				<Setter Property="MaxWidth" Value="0" />
				<Setter Property="MinWidth" Value="0" />
				<Setter Property="Width" Value="0" />
				<Setter Property="Margin" Value="0" />
			</Style>
		</ControlTheme>

		<ControlTheme x:Key="CaptionButtonsPool"
				  	TargetType="{x:Type ItemsControl}"
					BasedOn="{StaticResource CaptionButtonRolesBase}">
			<Setter Property="st:Sortable.Droppable" Value="True" />
			<Setter Property="st:Sortable.Sortable" Value="True" />

			<Setter Property="st:Sortable.DropCommand" Value="{Binding CBPoolDropCommand, Mode=OneWay}" />
			<Setter Property="st:Sortable.UpdateCommand" Value="{Binding CBPoolUpdateCommand, Mode=OneWay}" />

			<Setter Property="st:Sortable.CrossCollectionTransferMode" Value="Copy" />
			<Setter Property="ItemTemplate">
				<DataTemplate>
					<StackPanel x:Name="ItemLayoutRoot"
								Background="#01000000"
								Orientation="Vertical"
								Spacing="12"
								st:Sortable.IsSortable="True"
								st:Sortable.IsDroppable="True"
								Margin="0,5">
						<rcui:CaptionButton x:Name="CaptionButton"
											Classes="FakeCaptionButton"
											Margin="8,0,9,0">
							<TemplatedControl Theme="{DynamicResource CaptionButtonCluster.GlyphPresenter}"
											DataContext="{Binding Mode=OneWay}" />
						</rcui:CaptionButton>
						<TextBlock Text="{Binding Mode=OneWay}"
								HorizontalAlignment="Stretch"
								TextAlignment="Center" />
					</StackPanel>
				</DataTemplate>
			</Setter>
		</ControlTheme>




		<ControlTheme x:Key="CaptionButtonsBridgedWidth"
					TargetType="{x:Type TemplatedControl}">
			<Setter Property="Focusable" Value="False" />
			<Setter Property="IsTabStop" Value="False" />
			<Setter Property="Template">
				<ControlTemplate>
					<StackPanel Orientation="Vertical">
						<TextBlock HorizontalAlignment="{Binding $parent[TemplatedControl].HorizontalContentAlignment, Mode=OneWay}">
							<TextBlock.Text>
								<MultiBinding StringFormat="{}{0} bridged width: {1}">
									<TemplateBinding Property="(DockPanel.Dock)" />
									<Binding Mode="OneWay" />
								</MultiBinding>
							</TextBlock.Text>
						</TextBlock>
						<Border x:Name="CaptionButtonsWidthIndicator"
								Background="#0000FF"
								BorderBrush="#FF0000"
								BorderThickness="1"
								Width="{Binding Mode=OneWay}"
								Height="4"
								HorizontalAlignment="{Binding $parent[TemplatedControl].HorizontalContentAlignment, Mode=OneWay}" />
					</StackPanel>
				</ControlTemplate>
			</Setter>
		</ControlTheme>
	</Styles.Resources>


	<Style Selector=":is(vps|WindowView):not(.IsWindowUsingManagedChrome) :is(Control).RequiresManagedChrome.ToEnable">
		<Setter Property="IsEnabled" Value="False" />
	</Style>
	<Style Selector=":is(vps|WindowView):not(.IsWindowUsingManagedChrome) :is(Control).RequiresManagedChrome.ToBeVisible">
		<Setter Property="IsVisible" Value="False" />
	</Style>



	<Style Selector="rcui|CaptionButton.FakeCaptionButton">
		<Setter Property="Width" Value="{DynamicResource CaptionButton.MinWidth}" />
		<Setter Property="Height" Value="23" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
		<Setter Property="Focusable" Value="False" />
		<Setter Property="IsHitTestVisible" Value="False" />
		<Setter Property="Padding" Value="15,2" />
	</Style>
</Styles>