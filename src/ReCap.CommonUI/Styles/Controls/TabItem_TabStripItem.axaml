<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rcui="https://github.com/Resurrection-Capsule/ReCap.CommonUI">
    <ControlTheme x:Key="TabItemBackgroundTheme"
                TargetType="{x:Type TemplatedControl}">
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel>
                    <DockPanel x:Name="InnerTrim"
                            MinWidth="2"
                            MinHeight="2"
                            DockPanel.Dock="Bottom">
                        <Rectangle Classes="corner near"
                                DockPanel.Dock="Left" />
                        <Rectangle Classes="corner far"
                                DockPanel.Dock="Right" />
                        <Rectangle Classes="middle"
                                Fill="{DynamicResource TabItem.InnerEdge.BorderBrush.Idle}" />
                    </DockPanel>
                    <Panel ClipToBounds="True">
                        <rcui:AngledBorder x:Name="OuterBorder"
                                        BorderBrush="{DynamicResource TabItem.BorderBrush.Idle}"
                                        StrokeThickness="2"
                                        CornerRadius="3,3,0,0"
                                        Margin="0,0,0,-3">
                            <rcui:AngledBorder x:Name="InnerBorder"
                                            Background="{DynamicResource TabItem.Background.Idle}"
                                            Margin="1,1,1,0"
                                            CornerRadius="1,1,0,0" />
                        </rcui:AngledBorder>
                    </Panel>
                </DockPanel>
            </ControlTemplate>
        </Setter>


        <Style Selector="^ /template/ Rectangle.corner">
            <Setter Property="Fill" Value="{DynamicResource TabItem.InnerCorner.BorderBrush.Idle}" />
        </Style>


        <Style Selector="^[Tag=Top], ^[Tag=Bottom]">
            <Style Selector="^ /template/ Rectangle.corner">
                <Setter Property="Width" Value="3" />
            </Style>
        </Style>
        <Style Selector="^[Tag=Bottom]">
            <Style Selector="^ /template/ DockPanel#InnerTrim">
                <Setter Property="DockPanel.Dock" Value="Top" />
            </Style>
            <Style Selector="^ /template/ rcui|AngledBorder#OuterBorder">
                <Setter Property="Margin" Value="0,-3,0,0" />
                <Setter Property="CornerRadius" Value="0,0,3,3" />
            </Style>
            <Style Selector="^ /template/ rcui|AngledBorder#InnerBorder">
                <Setter Property="Margin" Value="1,0,1,1" />
                <Setter Property="CornerRadius" Value="0,0,1,1" />
            </Style>
        </Style>


        <Style Selector="^[Tag=Left], ^[Tag=Right]">
            <Style Selector="^ /template/ Rectangle.corner">
                <Setter Property="Height" Value="3" />
            </Style>
            <Style Selector="^ /template/ Rectangle.corner.near">
                <Setter Property="DockPanel.Dock" Value="Left" />
            </Style>
            <Style Selector="^ /template/ Rectangle.corner.far">
                <Setter Property="DockPanel.Dock" Value="Right" />
            </Style>
        </Style>
        <Style Selector="^[Tag=Left]">
            <Style Selector="^ /template/ DockPanel#InnerTrim">
                <Setter Property="DockPanel.Dock" Value="Right" />
            </Style>
            <Style Selector="^ /template/ rcui|AngledBorder#OuterBorder">
                <Setter Property="Margin" Value="0,0,-3,0" />
                <Setter Property="CornerRadius" Value="3,0,0,3" />
            </Style>
            <Style Selector="^ /template/ rcui|AngledBorder#InnerBorder">
                <Setter Property="Margin" Value="1,1,0,1" />
                <Setter Property="CornerRadius" Value="1,0,0,1" />
            </Style>
        </Style>
        <Style Selector="^[Tag=Right]">
            <Style Selector="^ /template/ DockPanel#InnerTrim">
                <Setter Property="DockPanel.Dock" Value="Left" />
            </Style>
            <Style Selector="^ /template/ rcui|AngledBorder#OuterBorder">
                <Setter Property="Margin" Value="-3,0,0,0" />
                <Setter Property="CornerRadius" Value="0,3,3,0" />
            </Style>
            <Style Selector="^ /template/ rcui|AngledBorder#InnerBorder">
                <Setter Property="Margin" Value="0,1,1,1" />
                <Setter Property="CornerRadius" Value="0,1,1,0" />
            </Style>
        </Style>


        <!--  Selected state  -->
        <Style Selector="^.selected">
            <Style Selector="^ /template/ Rectangle.corner">
                <Setter Property="Fill" Value="{DynamicResource TabItem.InnerCorner.BorderBrush.Selected}" />
            </Style>
            <Style Selector="^ /template/ Rectangle.middle">
                <Setter Property="Fill" Value="{DynamicResource TabItem.InnerEdge.BorderBrush.Selected}" />
            </Style>
            <Style Selector="^ /template/ rcui|AngledBorder#OuterBorder">
                <Setter Property="BorderBrush" Value="{DynamicResource TabItem.BorderBrush.Selected}" />
            </Style>
            <Style Selector="^ /template/ rcui|AngledBorder#InnerBorder">
                <Setter Property="Background" Value="{DynamicResource TabItem.Background.Selected}" />
            </Style>
        </Style>

        <!--  PointerOver state  -->
        <Style Selector="^.pointerover:not(.selected) /template/ rcui|AngledBorder#InnerBorder">
            <Setter Property="Background" Value="{DynamicResource TabItem.Background.Selected}" />
        </Style>

        <!--  Disabled state  -->
        <Style Selector="^.disabled">
            <!-- NYI -->
        </Style>
    </ControlTheme>


    <ControlTheme x:Key="TabItemThemeBase"
                TargetType="{x:Type ContentControl}">
        <Setter Property="Margin" Value="1" />
        <!--
        -->
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="4" />

        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="FontFamily" Value="{TemplateBinding FontFamily}" />
            <Setter Property="FontSize" Value="{TemplateBinding FontSize}" />
            <Setter Property="FontWeight" Value="{TemplateBinding FontWeight}" />
            <Setter Property="Margin" Value="{TemplateBinding Padding}" />
        </Style>


        <Style Selector="^ /template/ Panel#ContentPresenterContainer">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="6,0" />
        </Style>
    </ControlTheme>




    <ControlTheme x:Key="{x:Type TabStripItem}"
                TargetType="{x:Type TabStripItem}"
                BasedOn="{StaticResource TabItemThemeBase}">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <TemplatedControl x:Name="Background"
                                    Theme="{DynamicResource TabItemBackgroundTheme}"
                                    Classes.pointerover="{TemplateBinding IsPointerOver}"
                                    Classes.selected="{Binding IsSelected, RelativeSource={RelativeSource Mode=TemplatedParent}, Mode=OneWay}"
                                    Classes.disabled="{Binding !IsEnabled, RelativeSource={RelativeSource Mode=TemplatedParent}, Mode=OneWay}"
                                    Tag="Top" />
                    <Panel x:Name="ContentPresenterContainer">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Panel>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>




    <ControlTheme x:Key="{x:Type TabItem}"
                TargetType="{x:Type TabItem}"
                BasedOn="{StaticResource TabItemThemeBase}">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <TemplatedControl x:Name="Background"
                                    Theme="{DynamicResource TabItemBackgroundTheme}"
                                    Classes.pointerover="{TemplateBinding IsPointerOver}"
                                    Classes.selected="{Binding IsSelected, RelativeSource={RelativeSource Mode=TemplatedParent}, Mode=OneWay}"
                                    Classes.disabled="{Binding !IsEnabled, RelativeSource={RelativeSource Mode=TemplatedParent}, Mode=OneWay}"
                                    Tag="{TemplateBinding TabStripPlacement}" />
                    <Panel x:Name="ContentPresenterContainer">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                        Content="{TemplateBinding Header}"
                                        ContentTemplate="{TemplateBinding HeaderTemplate}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Panel>
                </Panel>
            </ControlTemplate>
        </Setter>


        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Content" Value="{Binding Header, RelativeSource={RelativeSource Mode=TemplatedParent}, Mode=OneWay}" />
            <Setter Property="ContentTemplate" Value="{Binding HeaderTemplate, RelativeSource={RelativeSource Mode=TemplatedParent}, Mode=OneWay}" />
        </Style>


        <!--  TabStripPlacement States Group  -->
        <Style Selector="^[TabStripPlacement=Left], ^[TabStripPlacement=Right]">
            <Style Selector="^ /template/ Panel#ContentPresenterContainer">
                <Setter Property="Margin" Value="0" />
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>