<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rcui="https://github.com/Resurrection-Capsule/ReCap.CommonUI">
	<ControlTheme x:Key="{x:Type rcui:TitleBarUnderlay}"
				  TargetType="{x:Type rcui:TitleBarUnderlay}">
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="ClipToBounds" Value="False" />
		<Setter Property="Win32Properties.NonClientHitTestResult" Value="Caption" />
		<Setter Property="Template">
			<ControlTemplate>
				<Panel x:Name="TemplateRoot"
					Background="#01000000"
					Margin="0,0,0,-5">
						<rcui:TitleBarAngledBorder x:Name="TitleBarBackgroundMain"
												Classes="activateColoration"
												Classes.isWindowUsingSystemChrome="{Binding !$parent[Window].(rcui:WindowChromeAddon.IsUsingManagedChrome), Mode=OneWay}"

												TopLeftMajorCut="{DynamicResource TitleBar.DefaultHeight}"
												TopLeftMinorCut="6"
												TopLeftInset="{Binding $parent[Window].(rcui:WindowChromeAddon.LeftCaptionButtonsWidth), Mode=OneWay}"

												TopRightMajorCut="{DynamicResource TitleBar.DefaultHeight}"
												TopRightMinorCut="6"
												TopRightInset="{Binding $parent[Window].(rcui:WindowChromeAddon.RightCaptionButtonsWidth), Mode=OneWay}"

												BottomLeftInset="16"
												BottomLeftCut="6"
												BottomRightInset="16"
												BottomRightCut="6"
												BorderBrush="{DynamicResource Window.TitleBar.BorderBrush}"
												StrokeThickness="1"
												IsHitTestVisible="False" />

						<!--
						<rcui:AngledBorderEx x:Name="LeftCaptionButtonsFrame"
										Classes="caption-buttons-frame"
										HorizontalAlignment="Left"
										VerticalAlignment="Stretch"
										IsVisible="False" />
						<rcui:AngledBorderEx x:Name="RightCaptionButtonsFrame"
										Classes="caption-buttons-frame"
										HorizontalAlignment="Right"
										VerticalAlignment="Stretch"
										IsVisible="False" />
						-->
				</Panel>
			</ControlTemplate>
		</Setter>
		<Style Selector="^[IsTitleBarVisible=False] /template/ rcui|TitleBarAngledBorder#TitleBarBackgroundMain">
			<Setter Property="Margin">
				<MultiBinding Converter="{x:Static rcui:BuildThicknessConverter.Instance}"
							ConverterParameter="0,_,0,0">
					<Binding Path="(rcui:WindowChromeAddon.DefaultTitleBarHeight)"
							RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}"
							Converter="{x:Static rcui:ArithmeticConverters.Invert}"
							Mode="OneWay" />
				</MultiBinding>
			</Setter>
		</Style>

		<Style Selector="^ /template/ rcui|TitleBarAngledBorder#TitleBarBackgroundMain[TopLeftInset=0]">
			<Setter Property="TopLeftMajorCut" Value="0" />
		</Style>
		<Style Selector="^[IsWindowMaximizedOrFullScreen=True] /template/ rcui|TitleBarAngledBorder#TitleBarBackgroundMain[TopLeftInset=0]">
			<Setter Property="TopLeftMinorCut" Value="0" />
		</Style>

		<Style Selector="^ /template/ rcui|TitleBarAngledBorder#TitleBarBackgroundMain[TopRightInset=0]">
			<Setter Property="TopRightMajorCut" Value="0" />
		</Style>
		<Style Selector="^[IsWindowMaximizedOrFullScreen=True] /template/ rcui|TitleBarAngledBorder#TitleBarBackgroundMain[TopRightInset=0]">
			<Setter Property="TopRightMinorCut" Value="0" />
		</Style>

		
		<Style Selector="^ /template/ rcui|TitleBarAngledBorder#TitleBarBackgroundMain.isWindowUsingSystemChrome">
			<Setter Property="TopLeftMajorCut" Value="0" />
			<Setter Property="TopLeftMinorCut" Value="0" />
			<Setter Property="TopRightMajorCut" Value="0" />
			<Setter Property="TopRightMinorCut" Value="0" />
		</Style>
		<!--
		<Style Selector="^[IsWindowMaximizedOrFullScreen=True] /template/ rcui|TitleBarAngledBorder#TitleBarBackgroundMain">
			<Setter Property="TopLeftMinorCut" Value="0" />
			<Setter Property="TopRightMinorCut" Value="0" />
		</Style>

		<Style Selector="^[IsWindowMaximizedOrFullScreen=True] /template/ rcui|TitleBarAngledBorder#TitleBarBackgroundMain[TopRightInset=0]">
			<Setter Property="TopRightMinorCut" Value="0" />
		</Style>
		<Style Selector="^[IsWindowMaximizedOrFullScreen=True] /template/ rcui|TitleBarAngledBorder#TitleBarBackgroundMain[TopLeftInset=0]">
			<Setter Property="TopLeftMinorCut" Value="0" />
		</Style>
		-->


		<Style Selector="^ /template/ :is(rcui|AngledBorderBase).activateColoration">
			<Setter Property="Background" Value="{DynamicResource Window.TitleBar.BackgroundBrush.Active}" />
		</Style>

		<Style Selector="^[IsWindowActive=False]">
			<Style Selector="^ /template/ :is(rcui|AngledBorderBase).activateColoration">
				<Setter Property="Background" Value="{DynamicResource Window.TitleBar.BackgroundBrush.Inactive}" />
			</Style>
		</Style>


		<Style Selector=":is(Window)[(rcui|WindowTransparencyHack.ActualIsTransparent)=True] /template/ ^, :is(Window)[ActualTransparencyLevel=Transparent] /template/ ^">
			<Style Selector="^:not(:fills_screen)">
				<Style Selector="^ /template/ rcui|AngledBorderEx#TitleBarBackgroundMain">
					<Setter Property="TopLeftCut" Value="6" />
				</Style>
			</Style>
		</Style>
	</ControlTheme>
</ResourceDictionary>
