<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rcui="https://github.com/Resurrection-Capsule/ReCap.CommonUI">
	<ControlTheme x:Key="{x:Type rcui:TitleBarUnderlay}"
				  TargetType="{x:Type rcui:TitleBarUnderlay}">
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="ClipToBounds" Value="False" />
		<Setter Property="IsVisible" Value="{Binding $self.IsTitleBarVisible, Mode=OneWay}" />
		<Setter Property="Height" Value="{Binding $self.DefaultTitleBarHeight, Mode=OneWay}" />
		<Setter Property="Template">
			<ControlTemplate>
				<Panel x:Name="TemplateRoot"
					Background="#01000000"
					>
					<!--
					Classes.left-side-buttons="{Binding Path=(rcui:WindowChromeAddon.LeftSideButtons), RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}, Mode=OneWay}"
					-->
					<!--
					<DockPanel>
						<Control x:Name="LeftCaptionButtons"
								IsHitTestVisible="False"
								IsTabStop="False"
								Focusable="False"
								DockPanel.Dock="Left" />
						<Control x:Name="RightCaptionButtons"
								IsHitTestVisible="False"
								IsTabStop="False"
								Focusable="False"
								DockPanel.Dock="Right" />
					</DockPanel>
					-->
					<!--
					<Panel x:Name="TitleBarBackgroundMainContainer">
					-->
						<!--
						<rcui:AngledBorderEx x:Name="TitleBarBackgroundMain"
											Classes="activateColoration"
											BorderBrush="{DynamicResource Window.TitleBar.BorderBrush}"
											IsHitTestVisible="False"
											TopRightCut="31"
											BottomLeftInset="18"
											BottomLeftCut="6"
											InvertSide="Bottom"
											Margin="0,0,0,-5" />
						-->
						<rcui:TitleBarAngledBorder2 x:Name="TitleBarBackgroundMain"
												Classes="activateColoration"

												Classes.HasLeftCaptionButtons="{Binding $parent[Window].(rcui:WindowChromeAddon.LeftCaptionButtons), Converter={x:Static rcui:CountIEnumerableConverters.Any}, Mode=OneWay}"
												TopLeftInset="{Binding $parent[Window].(rcui:WindowChromeAddon.LeftCaptionButtonsWidth), Mode=OneWay}"

												Classes.HasRightCaptionButtons="{Binding $parent[Window].(rcui:WindowChromeAddon.RightCaptionButtons), Converter={x:Static rcui:CountIEnumerableConverters.Any}, Mode=OneWay}"
												TopRightInset="{Binding $parent[Window].(rcui:WindowChromeAddon.RightCaptionButtonsWidth), Mode=OneWay}"

												BottomLeftInset="18"
												BottomLeftCut="6"
												BottomRightInset="18"
												BottomRightCut="6"
												BorderBrush="{DynamicResource Window.TitleBar.BorderBrush}"
												IsHitTestVisible="False"
												Margin="0,0,0,-5" />
						<!--
												TopLeftMajorCut="{DynamicResource TitleBar.DefaultHeight}"
												TopLeftMinorCut="6"

												TopRightMajorCut="{DynamicResource TitleBar.DefaultHeight}"
												TopRightMinorCut="6"

												BottomRightInset="{Binding $self.BottomLeftInset, Mode=OneWay}"
												BottomRightCut="{Binding $self.BottomLeftCut, Mode=OneWay}"
						-->
					<!--
					</Panel>
					-->
				</Panel>
			</ControlTemplate>
		</Setter>
		<Style Selector="^[IsWindowMaximizedOrFullScreen=False]">
		</Style>
		<Style Selector="^ /template/ rcui|TitleBarAngledBorder2#TitleBarBackgroundMain.HasLeftCaptionButtons">
			<!--
			<Setter Property="TopLeftMajorCut" Value="{DynamicResource TitleBar.DefaultHeight}" />
			<Setter Property="TopLeftMinorCut" Value="6" />
			-->
		</Style>
		<Style Selector="^ /template/ rcui|TitleBarAngledBorder2#TitleBarBackgroundMain.HasRightCaptionButtons">
			<!--
			<Setter Property="TopRightMajorCut" Value="{DynamicResource TitleBar.DefaultHeight}" />
			<Setter Property="TopRightMinorCut" Value="6" />
			-->
		</Style>
		<!--
		-->
		<Style Selector="^ /template/ rcui|TitleBarAngledBorder2#TitleBarBackgroundMain:not(.HasLeftCaptionButtons)">
			<Setter Property="TopLeftMajorCut" Value="0" />
			<!--
			<Setter Property="TopLeftMinorCut" Value="0" />
			-->
		</Style>
		<Style Selector="^ /template/ rcui|TitleBarAngledBorder2#TitleBarBackgroundMain:not(.HasRightCaptionButtons)">
			<Setter Property="TopRightMajorCut" Value="0" />
			<!--
			<Setter Property="TopRightMinorCut" Value="0" />
			-->
		</Style>
		<!--
		<Style Selector="^ /template/ Panel#TemplateRoot.left-side-buttons">
			<Setter Property="RenderTransform" Value="scale(-1, 1)" />
		</Style>
		<Style Selector=":is(Window[rcui:WindowChromeAddon.LeftCaptionButtonsWidth])^[IsTitleBarVisible=False][IsVisible=True]">
		-->

		<Style Selector="^[IsTitleBarVisible=False][IsVisible=True]">
			<Setter Property="Margin" Value="{Binding $self.DefaultTitleBarHeight, Converter={x:Static rcui:TitleBarHeightToUpwardMarginConverter.Instance}, ConverterParameter=14, Mode=OneWay}" />
		</Style>
		<Style Selector="^[IsTitleBarVisible=True][IsTitleBarHeightValid=True]">
			<Setter Property="Height" Value="{Binding $self.TitleBarHeight, Mode=OneWay}" />
		</Style>


		<Style Selector="^ /template/ :is(rcui|AngledBorderBase).activateColoration">
			<!--
			<Setter Property="StrokeThickness" Value="1" />
			-->
			<Setter Property="Background" Value="{DynamicResource Window.TitleBar.BackgroundBrush.Inactive}" />
		</Style>

		<Style Selector="^[IsWindowActive=True]">
			<Style Selector="^ /template/ :is(rcui|AngledBorderBase).activateColoration">
				<Setter Property="Background" Value="{DynamicResource Window.TitleBar.BackgroundBrush.Active}" />
			</Style>
		</Style>


		<Style Selector=":is(Window)[(rcui|WindowTransparencyHack.ActualIsTransparent)=True] /template/ ^, :is(Window)[ActualTransparencyLevel=Transparent] /template/ ^">
			<Style Selector="^:not(:fills_screen)">
				<Style Selector="^ /template/ rcui|AngledBorderEx#TitleBarBackgroundMain">
					<Setter Property="TopLeftCut" Value="6" />
				</Style>
			</Style>
		</Style>
	</ControlTheme>
</ResourceDictionary>
