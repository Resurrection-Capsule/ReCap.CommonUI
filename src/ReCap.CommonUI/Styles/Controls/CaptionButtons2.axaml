<ResourceDictionary xmlns="https://github.com/avaloniaui"
        			xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:rcui="https://github.com/Resurrection-Capsule/ReCap.CommonUI">
	<ControlTheme x:Key="CaptionButton2Base"
				TargetType="{x:Type rcui:CaptionButton}"
				BasedOn="{StaticResource {x:Type rcui:CaptionButton}}">
		<Style Selector="^ /template/ Panel#LayoutRoot">
			<Setter Property="Background" Value="#01000000" />
		</Style>
		<Style Selector="^ /template/ rcui|AngledBorder#BgElement">
			<Setter Property="MinWidth" Value="{DynamicResource CaptionButton.MinWidth}" />
			<Setter Property="VerticalAlignment" Value="Top" />
			<Setter Property="Height" Value="{Binding Bounds.Height, RelativeSource={RelativeSource Mode=TemplatedParent}, Mode=OneWay}" />
			<Setter Property="MaxHeight" Value="23" />
		</Style>
		<Style Selector="^[Role=Maximize], ^[Role=FullScreen]">
			<Setter Property="IsEnabled" Value="{Binding CanMaximize, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}, Mode=OneWay}" />
			<Setter Property="IsVisible" Value="{Binding CanResize, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}, Mode=OneWay}" />
		</Style>
		<Style Selector="^[Role=Minimize]">
			<Setter Property="IsEnabled" Value="{Binding CanMinimize, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}, Mode=OneWay}" />
			<Setter Property="IsVisible" Value="{Binding CanResize, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}, Mode=OneWay}" />
		</Style>
	</ControlTheme>
	<ControlTheme x:Key="CaptionButton2Left"
				TargetType="{x:Type rcui:CaptionButton}"
				BasedOn="{StaticResource CaptionButton2Base}">
		<Setter Property="CornerRadius" Value="5,0,5,0" />
		<Style Selector="^ /template/ rcui|AngledBorder#BgElement">
			<Setter Property="Margin" Value="9,8,4,0" />
		</Style>
	</ControlTheme>
	<ControlTheme x:Key="CaptionButton2Right"
				TargetType="{x:Type rcui:CaptionButton}"
				BasedOn="{StaticResource CaptionButton2Base}">
		<Style Selector="^ /template/ rcui|AngledBorder#BgElement">
			<Setter Property="Margin" Value="0,8,13,0" />
		</Style>
	</ControlTheme>




	<ControlTheme x:Key="{x:Type rcui:CaptionButtons2}"
		TargetType="{x:Type rcui:CaptionButtons2}">
		<Setter Property="ClipToBounds" Value="False" />
    	<Setter Property="Template">
      		<ControlTemplate>
				<DockPanel x:Name="LayoutRoot"
						LastChildFill="False">
					<rcui:CaptionButtonCluster x:Name="PART_LeftButtons"
											ItemContainerTheme="{DynamicResource CaptionButton2Left}"
											DockPanel.Dock="Left" />
					<rcui:CaptionButtonCluster x:Name="PART_RightButtons"
											ItemContainerTheme="{DynamicResource CaptionButton2Right}"
											DockPanel.Dock="Right" />
				</DockPanel>
			</ControlTemplate>
		</Setter>
		<Style Selector="^ /template/ DockPanel#LayoutRoot > rcui|CaptionButtonCluster">
			<Setter Property="ZIndex" Value="99999999" />
			<!--
			<Setter Property="IsVisible" Value="{TemplateBinding IsVisible}" />
			-->
		</Style>
		<!--
		<Style Selector="^:not(.isTitleBarVisible) /template/ DockPanel#LayoutRoot > rcui|CaptionButtonCluster">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		-->
	</ControlTheme>
</ResourceDictionary>