<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rcui="https://github.com/Resurrection-Capsule/ReCap.CommonUI"
                    x:ClassModifier="internal"
					x:CompileBindings="True">
    <ControlTheme x:Key="{x:Type ContextMenu}"
                TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{DynamicResource ContextMenu.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ContextMenu.BorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ContextMenu.BorderThickness}" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource MenuItem.Foreground.Idle}" />
		<Setter Property="FontFamily" Value="{DynamicResource ContextMenu.FontFamily}" />
		<Setter Property="FontSize" Value="{DynamicResource ContextMenu.FontSize}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="MinWidth" Value="{DynamicResource ContextMenu.MinWidth}" />
        <Setter Property="MinHeight" Value="{DynamicResource ContextMenu.MinHeight}" />
        <Setter Property="MaxWidth" Value="{DynamicResource ContextMenu.MaxWidth}" />
        <Setter Property="Padding" Value="{DynamicResource ContextMenu.Padding}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="WindowManagerAddShadowHint" Value="False" />
        <Setter Property="ItemsPanel" Value="{DynamicResource ContextMenu.ItemsPanel}" />
        <Setter Property="Template">
            <ControlTemplate>
                <ScrollViewer Theme="{StaticResource ReCapMenuScrollViewer}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            MaxWidth="{TemplateBinding MaxWidth}"
                            MinHeight="{TemplateBinding MinHeight}">
                    <ItemsPresenter x:Name="PART_ItemsPresenter"
                                    Margin="{TemplateBinding Padding}"
                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                    Grid.IsSharedSizeScope="True"
                                    ClipToBounds="False"
                                    KeyboardNavigation.TabNavigation="Continue" />
                </ScrollViewer>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>