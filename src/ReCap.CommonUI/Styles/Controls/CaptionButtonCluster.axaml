<ResourceDictionary xmlns="https://github.com/avaloniaui"
        			xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:rcui="https://github.com/Resurrection-Capsule/ReCap.CommonUI">
	<ControlTheme x:Key="CaptionButtonCluster.Button.Base"
				TargetType="{x:Type rcui:CaptionButton}"
				BasedOn="{StaticResource {x:Type rcui:CaptionButton}}">
		<Setter Property="Content" Value="{Binding $self.Role, Mode=OneWay}" />
		<Setter Property="Inset" Value="0,8,0,0" />
		<Style Selector="^ /template/ Panel#LayoutRoot">
			<Setter Property="Background" Value="#01000000" />
		</Style>


		<Style Selector="^ /template/ :is(Control).inset">
			<Setter Property="Width" Value="{DynamicResource CaptionButton.Width}" />
			<Setter Property="Height" Value="{Binding Bounds.Height, RelativeSource={RelativeSource Mode=TemplatedParent}, Mode=OneWay}" />
			<Setter Property="MaxHeight" Value="{DynamicResource CaptionButton.Height}" />
			<Setter Property="VerticalAlignment" Value="Top" />
		</Style>


		<Style Selector="^:traffic-light">
			<Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
				<Setter Property="IsVisible" Value="{Binding IsPointerOver, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type rcui:CaptionButtonCluster}}, Mode=OneWay}" />
			</Style>


			<!-- Maximize -->
			<Style Selector="^[Role=Maximize]">
				<!-- Idle -->
				<Style Selector="^ /template/ rcui|AngledBorder#BgElement">
					<Setter Property="Background" Value="{DynamicResource CaptionButton.TrafficLight.Maximize.Background.Idle}" />
					<Setter Property="BorderBrush" Value="{DynamicResource CaptionButton.TrafficLight.Maximize.BorderBrush.Idle}" />
				</Style>
				<Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
					<Setter Property="Foreground" Value="{DynamicResource CaptionButton.TrafficLight.Maximize.Foreground.Idle}" />
				</Style>


				<!-- Idle (inactive window) -->
				<Style Selector="^:not(:window-active)">
					<Style Selector="^ /template/ rcui|AngledBorder#BgElement">
						<Setter Property="Background" Value="{DynamicResource CaptionButton.TrafficLight.Maximize.Background.Idle.Inactive}" />
						<Setter Property="BorderBrush" Value="{DynamicResource CaptionButton.TrafficLight.Maximize.BorderBrush.Idle.Inactive}" />
					</Style>
					<Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
						<Setter Property="Foreground" Value="{DynamicResource CaptionButton.TrafficLight.Maximize.Foreground.Idle.Inactive}" />
					</Style>
				</Style>


				<!-- Hover -->
				<Style Selector="^:pointerover:not(:pressed)">
					<Style Selector="^ /template/ rcui|AngledBorder#BgElement">
						<Setter Property="Background" Value="{DynamicResource CaptionButton.TrafficLight.Maximize.Background.Hover}" />
						<Setter Property="BorderBrush" Value="{DynamicResource CaptionButton.TrafficLight.Maximize.BorderBrush.Hover}" />
					</Style>
					<Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
						<Setter Property="Foreground" Value="{DynamicResource CaptionButton.TrafficLight.Maximize.Foreground.Hover}" />
					</Style>
				</Style>


				<!-- Pressed -->
				<Style Selector="^:pressed, ^:checked">
					<Style Selector="^ /template/ rcui|AngledBorder#BgElement">
						<Setter Property="Background" Value="{DynamicResource CaptionButton.TrafficLight.Maximize.Background.Pressed}" />
						<Setter Property="BorderBrush" Value="{DynamicResource CaptionButton.TrafficLight.Maximize.BorderBrush.Pressed}" />
					</Style>
					<Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
						<Setter Property="Foreground" Value="{DynamicResource CaptionButton.TrafficLight.Maximize.Foreground.Pressed}" />
					</Style>
				</Style>
			</Style>


			<!-- Minimize -->
			<Style Selector="^[Role=Minimize]">
				<!-- Idle -->
				<Style Selector="^ /template/ rcui|AngledBorder#BgElement">
					<Setter Property="Background" Value="{DynamicResource CaptionButton.TrafficLight.Minimize.Background.Idle}" />
					<Setter Property="BorderBrush" Value="{DynamicResource CaptionButton.TrafficLight.Minimize.BorderBrush.Idle}" />
				</Style>
				<Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
					<Setter Property="Foreground" Value="{DynamicResource CaptionButton.TrafficLight.Minimize.Foreground.Idle}" />
				</Style>


				<!-- Idle (inactive window) -->
				<Style Selector="^:not(:window-active)">
					<Style Selector="^ /template/ rcui|AngledBorder#BgElement">
						<Setter Property="Background" Value="{DynamicResource CaptionButton.TrafficLight.Minimize.Background.Idle.Inactive}" />
						<Setter Property="BorderBrush" Value="{DynamicResource CaptionButton.TrafficLight.Minimize.BorderBrush.Idle.Inactive}" />
					</Style>
					<Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
						<Setter Property="Foreground" Value="{DynamicResource CaptionButton.TrafficLight.Minimize.Foreground.Idle.Inactive}" />
					</Style>
				</Style>


				<!-- Hover -->
				<Style Selector="^:pointerover:not(:pressed)">
					<Style Selector="^ /template/ rcui|AngledBorder#BgElement">
						<Setter Property="Background" Value="{DynamicResource CaptionButton.TrafficLight.Minimize.Background.Hover}" />
						<Setter Property="BorderBrush" Value="{DynamicResource CaptionButton.TrafficLight.Minimize.BorderBrush.Hover}" />
					</Style>
					<Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
						<Setter Property="Foreground" Value="{DynamicResource CaptionButton.TrafficLight.Minimize.Foreground.Hover}" />
					</Style>
				</Style>


				<!-- Pressed -->
				<Style Selector="^:pressed, ^:checked">
					<Style Selector="^ /template/ rcui|AngledBorder#BgElement">
						<Setter Property="Background" Value="{DynamicResource CaptionButton.TrafficLight.Minimize.Background.Pressed}" />
						<Setter Property="BorderBrush" Value="{DynamicResource CaptionButton.TrafficLight.Minimize.BorderBrush.Pressed}" />
					</Style>
					<Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
						<Setter Property="Foreground" Value="{DynamicResource CaptionButton.TrafficLight.Minimize.Foreground.Pressed}" />
					</Style>
				</Style>
			</Style>


			<!-- Close -->
			<Style Selector="^[Role=Close]">
				<!-- Idle (inactive window) -->
				<Style Selector="^:not(:window-active)">
					<Style Selector="^ /template/ rcui|AngledBorder#BgElement">
						<Setter Property="Background" Value="{DynamicResource CaptionButton.Background.Idle.Inactive}" />
						<Setter Property="BorderBrush" Value="{DynamicResource CaptionButton.BorderBrush.Idle.Inactive}" />
					</Style>
					<Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
						<Setter Property="Foreground" Value="{DynamicResource CaptionButton.Foreground.Idle.Inactive}" />
					</Style>
				</Style>


				<!-- Hover -->
				<Style Selector="^:pointerover:not(:pressed)">
					<Style Selector="^ /template/ rcui|AngledBorder#BgElement">
						<Setter Property="Background" Value="{DynamicResource CaptionButton.Background.Hover}" />
						<Setter Property="BorderBrush" Value="{DynamicResource CaptionButton.BorderBrush.Hover}" />
					</Style>
					<Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
						<Setter Property="Foreground" Value="{DynamicResource CaptionButton.TrafficLight.Foreground.Hover}" />
					</Style>
				</Style>


				<!-- Pressed -->
				<Style Selector="^:pressed, ^:checked">
					<Style Selector="^ /template/ rcui|AngledBorder#BgElement">
						<Setter Property="Background" Value="{DynamicResource CaptionButton.Background.Pressed}" />
						<Setter Property="BorderBrush" Value="{DynamicResource CaptionButton.BorderBrush.Pressed}" />
					</Style>
					<Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
						<Setter Property="Foreground" Value="{DynamicResource CaptionButton.TrafficLight.Foreground.Pressed}" />
					</Style>
				</Style>
			</Style>
		</Style>
	</ControlTheme>
	<ControlTheme x:Key="CaptionButtonCluster.Button.Left"
				TargetType="{x:Type rcui:CaptionButton}"
				BasedOn="{StaticResource CaptionButtonCluster.Button.Base}">
		<Setter Property="LeftGap" Value="0" />
		<Setter Property="RightGap" Value="2" />
		<Setter Property="CornerRadius" Value="{DynamicResource CaptionButton.CornerRadius.Left}" />
		<Style Selector="^:nth-child(1)">
			<Setter Property="Inset" Value="5,8,0,0" />
		</Style>
		<Style Selector="^:nth-last-child(1)">
			<Setter Property="RightGap" Value="0" />
		</Style>
	</ControlTheme>
	<ControlTheme x:Key="CaptionButtonCluster.Button.Right"
				TargetType="{x:Type rcui:CaptionButton}"
				BasedOn="{StaticResource CaptionButtonCluster.Button.Base}">
		<Setter Property="LeftGap" Value="2" />
		<Setter Property="RightGap" Value="0" />
		<Style Selector="^:nth-last-child(1)">
			<Setter Property="Inset" Value="0,8,13,0" />
		</Style>
		<Style Selector="^:nth-child(1)">
			<Setter Property="LeftGap" Value="0" />
		</Style>
	</ControlTheme>
	<DataTemplate x:Key="CaptionButtonCluster.ItemTemplate">
		<Path Data="{Binding CurrentGlyph, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type rcui:CaptionButton}}, Mode=OneWay}"
			Stretch="None"
			Fill="{Binding Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ContentPresenter}}, Mode=OneWay}"
			IsHitTestVisible="False" />
	</DataTemplate>




	<ControlTheme x:Key="CaptionButtonCluster.Button.WindowMenu.Base"
				TargetType="{x:Type rcui:CaptionButton}"
				BasedOn="{StaticResource {x:Type rcui:CaptionButton}}">
		<Setter Property="Background" Value="#01000000" />
		<Setter Property="Height" Value="{DynamicResource CaptionButton.Height}" />
		<Setter Property="Padding" Value="10,3" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Bottom" />
		<Setter Property="ClipToBounds" Value="False" />
		<Setter Property="Template">
			<ControlTemplate>
				<Panel x:Name="LayoutRoot"
					Background="{TemplateBinding Background}">
					<ContentPresenter x:Name="PART_ContentPresenter"
									Classes="inset"
									Content="{TemplateBinding Content}"
									ContentTemplate="{TemplateBinding ContentTemplate}"
									Padding="{TemplateBinding Padding}"
									HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
									VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
				</Panel>
			</ControlTemplate>
		</Setter>
	</ControlTheme>
	<ControlTheme x:Key="CaptionButtonCluster.Button.WindowMenu.Left"
				TargetType="{x:Type rcui:CaptionButton}"
				BasedOn="{StaticResource CaptionButtonCluster.Button.WindowMenu.Base}">
		<Style Selector="^:nth-last-child(1)">
			<Style Selector="^:not(:nth-child(1))">
				<Setter Property="LeftGap" Value="20" />
			</Style>
			<Style Selector="^:window-icon-visible">
				<Setter Property="RightGap" Value="-58" />
			</Style>
			<Style Selector="^:not(:window-icon-visible)">
				<Style Selector="^:window-leftbuttons-multiple">
					<Setter Property="LeftGap" Value="-2" />
				</Style>
				<Setter Property="RightGap" Value="-36" />
				<Setter Property="Opacity" Value="0.01" />
			</Style>
		</Style>
	</ControlTheme>
	<ControlTheme x:Key="CaptionButtonCluster.Button.WindowMenu.Right"
				TargetType="{x:Type rcui:CaptionButton}"
				BasedOn="{StaticResource CaptionButtonCluster.Button.WindowMenu.Base}">
		<Style Selector="^:nth-child(1)">
			<Style Selector="^:not(:nth-last-child(1))">
				<Setter Property="RightGap" Value="20" />
			</Style>
			<Style Selector="^:window-icon-visible">
				<Setter Property="LeftGap" Value="-58" />
			</Style>
			<Style Selector="^:not(:window-icon-visible)">
				<Style Selector="^:window-rightbuttons-multiple">
					<Setter Property="RightGap" Value="-2" />
				</Style>
				<Setter Property="LeftGap" Value="-36" />
				<Setter Property="Opacity" Value="0.01" />
			</Style>
		</Style>
	</ControlTheme>
	<DataTemplate x:Key="CaptionButtonCluster.ItemTemplate.WindowMenu">
		<rcui:ImagePresenter IsHitTestVisible="False"
							Width="16"
							Height="16"
							Source="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}, Converter={x:Static rcui:WindowIconToMultipleSizesWrapperImageConverter.Instance}, Mode=OneWay, FallbackValue={x:Null}}" />
	</DataTemplate>




	<ControlTheme x:Key="{x:Type rcui:CaptionButtonCluster}"
				TargetType="{x:Type rcui:CaptionButtonCluster}">
		<Setter Property="IsVisible" Value="{Binding $parent[Window].(rcui:WindowChrome.Chrome).IsChromeManaged, Mode=OneWay}" />
		<Setter Property="ItemTemplate" Value="{DynamicResource CaptionButtonCluster.ItemTemplate}" />
		<Setter Property="WindowMenuItemTemplate" Value="{DynamicResource CaptionButtonCluster.ItemTemplate.WindowMenu}" />
		<Setter Property="ClipToBounds" Value="False" />
		<Setter Property="Template">
			<ControlTemplate>
				<ItemsPresenter x:Name="PART_ItemsPresenter"
								ItemsPanel="{TemplateBinding ItemsPanel}" />
			</ControlTemplate>
		</Setter>


		<Style Selector="^[Position=Left]">
			<Style Selector="^[IsVisible=True]">
				<!--
				<Style Selector="^ /template/ rcui|CaptionButtonClusterPanel#PART_ItemsPanel">
				-->
				<Setter Property="ItemsSource">
					<MultiBinding Converter="{x:Static rcui:WindowChromeToCaptionButtonRolesConverter.Instance}">
						<Binding Path="(rcui:WindowChrome.Chrome)"
								RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}"
								Mode="OneWay" />
						<Binding Path="(rcui:WindowChrome.Chrome).LeftCaptionButtonRoles"
								RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}"
								Mode="OneWay" />
					</MultiBinding>
				</Setter>
			</Style>
			<Setter Property="ItemContainerTheme" Value="{DynamicResource CaptionButtonCluster.Button.Left}" />
			<Setter Property="WindowMenuItemContainerTheme" Value="{DynamicResource CaptionButtonCluster.Button.WindowMenu.Left}" />
		</Style>
		<Style Selector="^[Position=Right]">
			<Style Selector="^[IsVisible=True]">
				<Setter Property="ItemsSource">
					<MultiBinding Converter="{x:Static rcui:WindowChromeToCaptionButtonRolesConverter.Instance}">
						<Binding Path="(rcui:WindowChrome.Chrome)"
								RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}"
								Mode="OneWay" />
						<Binding Path="(rcui:WindowChrome.Chrome).RightCaptionButtonRoles"
								RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}"
								Mode="OneWay" />
					</MultiBinding>
				</Setter>
			</Style>
			<Setter Property="ItemContainerTheme" Value="{DynamicResource CaptionButtonCluster.Button.Right}" />
			<Setter Property="WindowMenuItemContainerTheme" Value="{DynamicResource CaptionButtonCluster.Button.WindowMenu.Right}" />
		</Style>
	</ControlTheme>
</ResourceDictionary>