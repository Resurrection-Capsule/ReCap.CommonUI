<ResourceDictionary xmlns="https://github.com/avaloniaui"
        			xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:rcui="https://github.com/Resurrection-Capsule/ReCap.CommonUI">
	<ControlTheme x:Key="CaptionButtonCluster.Button.Base"
				TargetType="{x:Type rcui:CaptionButton}"
				BasedOn="{StaticResource {x:Type rcui:CaptionButton}}">
		<Setter Property="Content" Value="{Binding $self.Role, Mode=OneWay}" />
		<Style Selector="^ /template/ Panel#LayoutRoot">
			<Setter Property="Background" Value="#01000000" />
		</Style>


		<Style Selector="^ /template/ :is(Control).inset">
			<Setter Property="Width" Value="{DynamicResource CaptionButton.Width}" />
			<Setter Property="Height" Value="{Binding Bounds.Height, RelativeSource={RelativeSource Mode=TemplatedParent}, Mode=OneWay}" />
			<Setter Property="MaxHeight" Value="{DynamicResource CaptionButton.Height}" />
			<Setter Property="VerticalAlignment" Value="Top" />
		</Style>
	</ControlTheme>
	<ControlTheme x:Key="CaptionButtonCluster.Button.Left"
				TargetType="{x:Type rcui:CaptionButton}"
				BasedOn="{StaticResource CaptionButtonCluster.Button.Base}">
		<Setter Property="CornerRadius" Value="{DynamicResource CaptionButton.CornerRadius.Left}" />
		<Style Selector="^ /template/ :is(Control).inset">
			<Setter Property="Margin" Value="0,8,0,0" />
		</Style>
		<Style Selector="^:nth-child(1) /template/ :is(Control).inset">
			<Setter Property="Margin" Value="5,8,0,0" />
		</Style>
	</ControlTheme>
	<ControlTheme x:Key="CaptionButtonCluster.Button.Right"
				TargetType="{x:Type rcui:CaptionButton}"
				BasedOn="{StaticResource CaptionButtonCluster.Button.Base}">
		<Style Selector="^ /template/ :is(Control).inset">
			<Setter Property="Margin" Value="0,8,0,0" />
		</Style>
		<Style Selector="^:nth-last-child(1) /template/ :is(Control).inset">
			<Setter Property="Margin" Value="0,8,13,0" />
		</Style>
	</ControlTheme>
	<DataTemplate x:Key="CaptionButtonCluster.ItemTemplate">
		<Path Data="{Binding CurrentGlyph, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type rcui:CaptionButton}}, Mode=OneWay}"
			Stretch="None"
			Fill="{Binding Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ContentPresenter}}, Mode=OneWay}" />
	</DataTemplate>




	<ControlTheme x:Key="CaptionButtonCluster.Button.WindowMenu.Base"
				TargetType="{x:Type rcui:CaptionButton}"
				BasedOn="{StaticResource {x:Type rcui:CaptionButton}}">
		<Setter Property="Background" Value="#40FF00FF" />
		<Setter Property="Height" Value="{DynamicResource CaptionButton.Height}" />
		<Setter Property="Padding" Value="10,3" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Bottom" />
		<Setter Property="ClipToBounds" Value="False" />
		<Setter Property="Template">
			<ControlTemplate>
				<Panel x:Name="LayoutRoot"
					Background="{TemplateBinding Background}">
					<ContentPresenter x:Name="PART_ContentPresenter"
									Classes="inset"
									Content="{TemplateBinding Content}"
									ContentTemplate="{TemplateBinding ContentTemplate}"
									Padding="{TemplateBinding Padding}"
									HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
									VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
				</Panel>
			</ControlTemplate>
		</Setter>
	</ControlTheme>
	<ControlTheme x:Key="CaptionButtonCluster.Button.WindowMenu.Left"
				TargetType="{x:Type rcui:CaptionButton}"
				BasedOn="{StaticResource CaptionButtonCluster.Button.WindowMenu.Base}">
		<Style Selector="^:nth-last-child(1)">
			<Style Selector="^:not(:nth-child(1)) /template/ :is(Control).inset">
				<Setter Property="Margin" Value="20,0,-58,0" />
			</Style>
			<Style Selector="^:not(:roleactive)">
				<Setter Property="Opacity" Value="0.01" />
				<Setter Property="Background" Value="#FF000000" />
			</Style>
		</Style>
	</ControlTheme>
	<ControlTheme x:Key="CaptionButtonCluster.Button.WindowMenu.Right"
				TargetType="{x:Type rcui:CaptionButton}"
				BasedOn="{StaticResource CaptionButtonCluster.Button.WindowMenu.Base}">
		<Style Selector="^:nth-child(1)">
			<Style Selector="^:not(:nth-last-child(1)) /template/ :is(Control).inset">
				<Setter Property="Margin" Value="-58,0,20,0" />
			</Style>
			<Style Selector="^:not(:roleactive)">
				<Setter Property="Opacity" Value="0.01" />
				<Setter Property="Background" Value="#FF000000" />
			</Style>
		</Style>
	</ControlTheme>
	<DataTemplate x:Key="CaptionButtonCluster.ItemTemplate.WindowMenu">
		<rcui:ImagePresenter IsHitTestVisible="False"
							Width="16"
							Height="16"
							Source="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}, Converter={x:Static rcui:WindowIconToMultipleSizesWrapperImageConverter.Instance}, Mode=OneWay, FallbackValue={x:Null}}" />
	</DataTemplate>




	<ControlTheme x:Key="{x:Type rcui:CaptionButtonCluster}"
				TargetType="{x:Type rcui:CaptionButtonCluster}">
		<Setter Property="IsVisible" Value="{Binding $parent[Window].(rcui:ManagedWindowChrome.IsChromeManaged), Mode=OneWay}" />
		<Setter Property="ItemTemplate" Value="{DynamicResource CaptionButtonCluster.ItemTemplate}" />
		<Setter Property="WindowMenuItemTemplate" Value="{DynamicResource CaptionButtonCluster.ItemTemplate.WindowMenu}" />
		<Setter Property="ClipToBounds" Value="False" />
		<Setter Property="Template">
			<ControlTemplate>
				<ItemsPresenter x:Name="PART_ItemsPresenter"
								ItemsPanel="{TemplateBinding ItemsPanel}" />
			</ControlTemplate>
		</Setter>
		<Setter Property="ItemsPanel">
			<ItemsPanelTemplate>
				<StackPanel x:Name="PART_ItemsPanel"
							Orientation="Horizontal"
							Spacing="2" />
			</ItemsPanelTemplate>
		</Setter>


		<Style Selector="^[Position=Left]">
			<Setter Property="ItemContainerTheme" Value="{DynamicResource CaptionButtonCluster.Button.Left}" />
			<Setter Property="WindowMenuItemContainerTheme" Value="{DynamicResource CaptionButtonCluster.Button.WindowMenu.Left}" />
		</Style>
		<Style Selector="^[Position=Right]">
			<Setter Property="ItemContainerTheme" Value="{DynamicResource CaptionButtonCluster.Button.Right}" />
			<Setter Property="WindowMenuItemContainerTheme" Value="{DynamicResource CaptionButtonCluster.Button.WindowMenu.Right}" />
		</Style>
	</ControlTheme>
</ResourceDictionary>