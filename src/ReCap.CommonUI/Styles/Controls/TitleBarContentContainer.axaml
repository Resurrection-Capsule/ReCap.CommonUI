<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rcui="https://github.com/Resurrection-Capsule/ReCap.CommonUI"
                    x:CompileBindings="True">
    <ControlTheme x:Key="{x:Type rcui:TitleBarContentContainer}"
                TargetType="{x:Type rcui:TitleBarContentContainer}">
        <Setter Property="Padding" Value="5" />
        <Setter Property="ClipToBounds" Value="False" />

        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <!--
        <Setter Property="VerticalAlignment" Value="Top" />
        -->
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />

        <!--
        <Setter Property="DockPanel.Dock" Value="Top" />
        -->
        <Setter Property="Template">
            <ControlTemplate>
                <Grid x:Name="TemplateRoot"
                    ColumnDefinitions="Auto,*,Auto"
                    RowDefinitions="Auto,Auto"
                    Classes.isUsingManagedChrome="{Binding $parent[Window].(rcui:WindowChromeAddon.IsUsingManagedChrome), Mode=OneWay}"
                    Classes.reserveCaptionArea="{Binding $parent[Window].(rcui:WindowChromeOptions.ReserveCaptionArea), Mode=OneWay}">

                    <Control x:Name="Left"
                            Classes="spacing"
                            Width="{TemplateBinding ComputedLeftInset}"
                            Grid.Column="0"
                            Grid.Row="0" />

                    <Control x:Name="Right"
                            Classes="spacing"
                            Width="{TemplateBinding ComputedRightInset}"
                            Grid.Column="2"
                            Grid.Row="0" />

                    <Control x:Name="Top"
                            Classes="spacing"
                            Height="0"
                            Grid.Column="1"
                            Grid.Row="0" />


                    <Border x:Name="PART_InsetReference"
                            Classes="spacing"
                            Margin="{TemplateBinding Padding}"
                            Grid.Column="1"
                            Grid.Row="0"
                            Grid.RowSpan="2" />
                    <!--
                            Background="#40FF00FF"
                    -->


                    <ContentPresenter x:Name="PART_ContentPresenter"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Margin="{TemplateBinding Padding}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"

                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"

                                    Grid.Column="1"
                                    Grid.Row="0"
                                    Grid.RowSpan="2" />
                    <!--
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                    -->
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:not(:managed_decorations)">
            <Setter Property="TopLevelRootMargin" Value="{DynamicResource Window.SystemDecorations.RootMargin}" />
        </Style>
        <Style Selector="^ /template/ Control.spacing">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <!--
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            -->
        </Style>

        <Style Selector="^ /template/ Grid.isUsingManagedChrome.reserveCaptionArea > Control#Top">
            <Setter Property="Height" Value="{TemplateBinding ComputedTopInset}" />
        </Style>


        <!--
        <Style Selector="^[IsContentInsideReservedArea=False] /template/ Grid.isUsingManagedChrome > ContentPresenter#PART_ContentPresenter">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.RowSpan" Value="2" />
        </Style>
        -->
        <Style Selector="^[IsContentInsideReservedArea=True] /template/ Grid > ContentPresenter#PART_ContentPresenter">
            <!--
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.RowSpan" Value="1" />
            -->
            <!--
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.ColumnSpan" Value="1" />
            -->
        </Style>


        <!--
        <Style Selector="^ /template/ :is(Panel)#TemplateRoot > :is(Control)">
            <!- -
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="{TemplateBinding HorizontalContentAlignment}" />
            <Setter Property="VerticalContentAlignment" Value="{TemplateBinding VerticalContentAlignment}" />
            - ->
            <Setter Property="HorizontalAlignment" Value="{TemplateBinding HorizontalContentAlignment}" />
            <Setter Property="VerticalAlignment" Value="{TemplateBinding VerticalContentAlignment}" />
        </Style>
        -->
    </ControlTheme>
</ResourceDictionary>