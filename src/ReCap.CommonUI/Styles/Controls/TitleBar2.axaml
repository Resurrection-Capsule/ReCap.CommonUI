<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rcui="https://github.com/Resurrection-Capsule/ReCap.CommonUI">
	<ControlTheme x:Key="{x:Type rcui:TitleBar2}"
				TargetType="{x:Type rcui:TitleBar2}">
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Top" />
		
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource StrongForegroundBrush}" />
		
		<Setter Property="FontFamily" Value="{DynamicResource HeaderFont}" />
		<Setter Property="FontSize" Value="15" />
		<Setter Property="Padding" Value="20,2" />
		<Setter Property="MinHeight" Value="32" />

		<Setter Property="ClipToBounds" Value="False" />
		
		<!--
		<Setter Property="Win32Properties.NonClientHitTestResult" Value="Caption" />
		-->
		<Setter Property="Template">
			<ControlTemplate>
				<Panel VerticalAlignment="Top">
					<Panel>
						<Border Background="{TemplateBinding Background}"
								IsHitTestVisible="False"
								Win32Properties.NonClientHitTestResult="Caption" />
						<DockPanel x:Name="ClustersContainer">
							<rcui:CaptionButtonCluster x:Name="LeftCluster"
													DockPanel.Dock="Left" />
							<rcui:CaptionButtonCluster x:Name="RightCluster"
													DockPanel.Dock="Right" />
							<Panel x:Name="TitleContainerL"
									DataContext="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}, Mode=OneWay}"
									IsVisible="{Binding (rcui:WindowChrome.ReserveCaptionArea), Mode=OneWay}"
									IsHitTestVisible="False">
								<Panel x:Name="TitleContainerR">
									<TextBlock x:Name="TitleDisplay"
											VerticalAlignment="Center"
											HorizontalAlignment="Left"
											Text="{Binding Title, Mode=OneWay}"
											IsVisible="{Binding (rcui:WindowChrome.StateInfo).IsTitleVisible, Mode=OneWay}"
											Classes.showIcon="{Binding (rcui:WindowChrome.StateInfo).IsIconVisible, Mode=OneWay}" />
								</Panel>
							</Panel>
						</DockPanel>
					</Panel>
					<rcui:CaptionButtonsBroker x:Name="PART_CaptionButtons"
											HorizontalAlignment="Stretch"
											VerticalAlignment="Top"
											Foreground="{TemplateBinding Foreground}"
											LeftCluster="{Binding ElementName=LeftCluster, Mode=OneWay}"
											RightCluster="{Binding ElementName=RightCluster, Mode=OneWay}" />
					<!--
											Win32Properties.NonClientHitTestResult="Client"
					-->

					<!--
					<Panel x:Name="MouseTracker"
						Height="1"
						VerticalAlignment="Top" />
					-->
				</Panel>
			</ControlTemplate>
		</Setter>


		<Style Selector="^ /template/ :is(Panel)#ClustersContainer > Control[Width=0]">
			<Setter Property="IsVisible" Value="False" />
		</Style>


		<Style Selector="^[LeftWindowMenuPresence=Irrelevant][LeftButtonCount=0] /template/ Panel#TitleContainerL">
			<Setter Property="Margin" Value="8,0,0,0" />
		</Style>
		<Style Selector="^[LeftWindowMenuPresence=Irrelevant]:not(^[LeftButtonCount=0]) /template/ Panel#TitleContainerL">
			<Setter Property="Margin" Value="28,0,0,0" />
		</Style>
		<Style Selector="^[LeftWindowMenuPresence=Innermost] /template/ Panel#TitleContainerL">
			<Setter Property="Margin" Value="58,0,0,0" />
		</Style>


		<Style Selector="^[RightWindowMenuPresence=Irrelevant][RightButtonCount=0] /template/ Panel#TitleContainerR">
			<Setter Property="Margin" Value="0,0,8,0" />
		</Style>
		<Style Selector="^[RightWindowMenuPresence=Irrelevant]:not(^[RightButtonCount=0]) /template/ Panel#TitleContainerR">
			<Setter Property="Margin" Value="0,0,28,0" />
		</Style>
		<Style Selector="^[RightWindowMenuPresence=Innermost] /template/ Panel#TitleContainerR">
			<Setter Property="Margin" Value="0,0,58,0" />
		</Style>
		<Style Selector="^ /template/ TextBlock#TitleDisplay:not(.showIcon)">
			<Setter Property="Margin" Value="-28,0" />
		</Style>



		<Style Selector="^:fullscreen /template/ Panel#MouseTracker">
			<Setter Property="Background" Value="Transparent" />
		</Style>

		<Style Selector="^:fullscreen /template/ Panel#PART_Container">
			<Setter Property="RenderTransform" Value="translateY(-30px)" />
			<Setter Property="Transitions">
				<Transitions>
					<TransformOperationsTransition Property="RenderTransform" Duration="0:0:.25" />
				</Transitions>
			</Setter>
		</Style>

		<Style Selector="^:fullscreen:pointerover /template/ Panel#PART_Container">
			<Setter Property="RenderTransform" Value="none" />
		</Style>
	</ControlTheme>
</ResourceDictionary>
