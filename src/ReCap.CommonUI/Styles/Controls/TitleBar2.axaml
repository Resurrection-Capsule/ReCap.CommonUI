<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rcui="https://github.com/Resurrection-Capsule/ReCap.CommonUI">
	<ControlTheme x:Key="{x:Type rcui:TitleBar2}"
				TargetType="{x:Type rcui:TitleBar2}">
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource StrongForegroundBrush}" />
		<Setter Property="FontFamily" Value="{DynamicResource HeaderFont}" />
		<Setter Property="FontSize" Value="15" />
		<Setter Property="Padding" Value="20,2" />
		<Setter Property="MinHeight" Value="32" />
		<Setter Property="ClipToBounds" Value="False" />
		<!--
		<Setter Property="Win32Properties.NonClientHitTestResult" Value="Caption" />
		-->
		<Setter Property="Template">
			<ControlTemplate>
				<Panel VerticalAlignment="Top">
					<Panel>
						<Border Background="{TemplateBinding Background}"
								IsHitTestVisible="False"
								Win32Properties.NonClientHitTestResult="Caption" />
						<DockPanel x:Name="ClustersContainer"
								LastChildFill="False">
							<rcui:CaptionButtonCluster x:Name="LeftCluster"
													DockPanel.Dock="Left" />
							<rcui:CaptionButtonCluster x:Name="RightCluster"
													DockPanel.Dock="Right" />
						</DockPanel>
						<DockPanel x:Name="TitleContainer"
								DataContext="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}, Mode=OneWay}"
								IsVisible="{Binding (rcui:WindowChrome.Chrome).IsTitleVisible, Mode=OneWay}">
							<Control Classes="insetter outer left" />
							<Control Classes="insetter outer right" />

							<Control Classes="insetter inner left" />
							<Control Classes="insetter inner right" />

							<TextBlock x:Name="TitleDisplay"
									VerticalAlignment="Center"
									HorizontalAlignment="Left"
									Text="{Binding Title, Mode=OneWay}"
									Grid.Column="1" />
						</DockPanel>
					</Panel>
					<rcui:CaptionButtonsBroker x:Name="PART_CaptionButtons"
											HorizontalAlignment="Stretch"
											VerticalAlignment="Top"
											Foreground="{TemplateBinding Foreground}"
											LeftCluster="{Binding ElementName=LeftCluster, Mode=OneWay}"
											RightCluster="{Binding ElementName=RightCluster, Mode=OneWay}" />
				</Panel>
			</ControlTemplate>
		</Setter>
		<Style Selector="^ /template/ DockPanel#TitleContainer > Control.insetter">
			<Setter Property="Focusable" Value="False" />
			<Setter Property="IsTabStop" Value="False" />
			<Setter Property="IsHitTestVisible" Value="False" />
			<Setter Property="DataContext" Value="{Binding (rcui:WindowChrome.Chrome), Mode=OneWay}" />
		</Style>
		<Style Selector="^ /template/ :is(Panel)#TitleContainer > Control.insetter">
			<Style Selector="^.left">
				<Setter Property="Grid.Column" Value="0" />
				<Setter Property="DockPanel.Dock" Value="Left" />
			</Style>
			<Style Selector="^.right">
				<Setter Property="Grid.Column" Value="2" />
				<Setter Property="DockPanel.Dock" Value="Right" />
			</Style>
		</Style>
		<Style Selector="^:window-icon-visible /template/ :is(Panel)#TitleContainer > Control.insetter.outer">
			<Style Selector="^.left">
				<Setter Property="Width" Value="{Binding LeftCaptionButtonsWidth, Mode=OneWay}" />
			</Style>
			<Style Selector="^.right">
				<Setter Property="Width" Value="{Binding RightCaptionButtonsWidth, Mode=OneWay}" />
			</Style>
		</Style>
		<Style Selector="^:not(:window-icon-visible) /template/ :is(Panel)#TitleContainer > Control.insetter.outer">
			<Style Selector="^.left">
				<Setter Property="Width" Value="{Binding CosmeticLeftCaptionButtonsWidth, Mode=OneWay}" />
			</Style>
			<Style Selector="^.right">
				<Setter Property="Width" Value="{Binding CosmeticRightCaptionButtonsWidth, Mode=OneWay}" />
			</Style>
		</Style>




		<Style Selector="^ /template/ :is(Panel)#ClustersContainer > Control[Width=0]">
			<Setter Property="IsVisible" Value="False" />
		</Style>


		<Style Selector="^:window-icon-visible">
			<Style Selector="^:window-leftbuttons-any:window-leftbuttons-has-windowmenu-at-mergeindex /template/ Control.insetter.inner.left,
							^:window-rightbuttons-any:window-rightbuttons-has-windowmenu-at-mergeindex /template/ Control.insetter.inner.right">
				<Setter Property="Width" Value="0" />
			</Style>
			<Style Selector="^:window-leftbuttons-any:not(:window-leftbuttons-has-windowmenu-at-mergeindex) /template/ Control.insetter.inner.left,
							^:window-rightbuttons-any:not(:window-rightbuttons-has-windowmenu-at-mergeindex) /template/ Control.insetter.inner.right">
				<Setter Property="Width" Value="32" />
			</Style>
		</Style>
		<Style Selector="^:not(:window-icon-visible)">
			<Style Selector="^:window-leftbuttons-multiple:window-leftbuttons-has-windowmenu-at-mergeindex /template/ Control.insetter.inner.left,
							^:window-rightbuttons-multiple:window-rightbuttons-has-windowmenu-at-mergeindex /template/ Control.insetter.inner.right">
				<Setter Property="Width" Value="32" />
			</Style>
			<Style Selector="^:window-leftbuttons-any:not(:window-leftbuttons-has-windowmenu-at-mergeindex) /template/ Control.insetter.inner.left,
							^:window-rightbuttons-any:not(:window-rightbuttons-has-windowmenu-at-mergeindex) /template/ Control.insetter.inner.right">
				<Setter Property="Width" Value="32" />
			</Style>
			<Style Selector="^:window-leftbuttons-any:not(:window-leftbuttons-multiple):window-leftbuttons-has-windowmenu-at-mergeindex /template/ Control.insetter.inner.left,
							^:window-rightbuttons-any:not(:window-rightbuttons-multiple):window-rightbuttons-has-windowmenu-at-mergeindex /template/ Control.insetter.inner.right">
				<Setter Property="Width" Value="16" />
			</Style>
		</Style>
		<Style Selector="^:not(:window-leftbuttons-any) /template/ Control.insetter.inner.left,
						^:not(:window-rightbuttons-any) /template/ Control.insetter.inner.right">
			<Setter Property="Width" Value="16" />
		</Style>



		<Style Selector="^:window-fullscreen /template/ Panel#MouseTracker">
			<Setter Property="Background" Value="Transparent" />
		</Style>

		<Style Selector="^:window-fullscreen /template/ Panel#PART_Container">
			<Setter Property="RenderTransform" Value="translateY(-30px)" />
			<Setter Property="Transitions">
				<Transitions>
					<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" />
				</Transitions>
			</Setter>
		</Style>

		<Style Selector="^:window-fullscreen:pointerover /template/ Panel#PART_Container">
			<Setter Property="RenderTransform" Value="none" />
		</Style>
	</ControlTheme>
</ResourceDictionary>
