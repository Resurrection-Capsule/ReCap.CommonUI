<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rcui="https://github.com/Resurrection-Capsule/ReCap.CommonUI">
    <ControlTheme x:Key="HelixWindow"
                TargetType="{x:Type Window}"
                BasedOn="{StaticResource {x:Type Window}}">
        <Style Selector="^ /template/ rcui|TitleBarUnderlay">
            <Setter Property="Theme" Value="{DynamicResource HelixTitleBarUnderlay}" />
        </Style>
		<!--
        <Style Selector="^ /template/ VisualLayerManager">
			<Setter Property="ChromeOverlayLayer">
				<Template>
					<rcui:TitleBar2 Theme="{DynamicResource HelixTitleBar2}" />
				</Template>
			</Setter>
        </Style>
        <Style Selector="^ /template/ rcui|TitleBar2">
            <Setter Property="Theme" Value="{DynamicResource HelixTitleBar2}" />
        </Style>
		-->


		<Style Selector="^[WindowState=Maximized], ^[WindowState=FullScreen]">
			<Style Selector="^ /template/ rcui|TitleBar2 /template/ rcui|CaptionButtons2 /template/ ItemsControl#PART_LeftButtons /template/ rcui|AngledBorderEx#BgElement">
				<Setter Property="TopLeftCut" Value="0" />
			</Style>
			<Style Selector="^ /template/ rcui|TitleBar2 /template/ rcui|CaptionButtons2 /template/ ItemsControl#PART_RightButtons /template/ rcui|AngledBorderEx#BgElement">
				<Setter Property="TopRightCut" Value="0" />
			</Style>
		</Style>


		<!--
        <Style Selector="^ /template/ rcui|AngledBorderEx#BgElement">
			<Setter Property="Margin" Value="0,64,0,0" />
        </Style>

		-->
		<Style Selector="^[(rcui|WindowChromeAddon.IsUsingManagedChrome)=False]">
			<Style Selector="^ /template/ rcui|AngledBorderEx#TopEdgeTrim">
				<!--
				<Setter Property="Height" Value="110" />
				<Setter Property="Margin" Value="0,-32,0,-69" />
				-->
				<Setter Property="Background" Value="{DynamicResource HelixWindow.TitleBar.BackgroundBrush.Inactive}" />
			</Style>

			<Style Selector="^[IsActive=True] /template/ rcui|AngledBorderEx#TopEdgeTrim">
				<Setter Property="Background" Value="{DynamicResource HelixWindow.TitleBar.BackgroundBrush.Active}" />
			</Style>
		</Style>
    </ControlTheme>


	<ControlTheme x:Key="HelixCaptionButtonsItemsControl"
				TargetType="{x:Type ItemsControl}"
				BasedOn="{StaticResource CaptionButtonsItemsControl}">
		<Setter Property="Template">
			<ControlTemplate>
				<Border x:Name="BgElement"
						Background="Blue"
						BorderBrush="Red"
						BorderThickness="1">
				<!--
				<rcui:AngledBorderEx x:Name="BgElement"
									Background="{DynamicResource HelixWindow.TitleBar.CaptionButtonsFrame.Background}"
									BorderBrush="{DynamicResource HelixWindow.TitleBar.CaptionButtonsFrame.BorderBrush}"
									StrokeThickness="1">
				-->
					<ItemsPresenter x:Name="PART_ItemsPresenter"
									ItemsPanel="{TemplateBinding ItemsPanel}" />
				<!--
				</rcui:AngledBorderEx>
				-->
				</Border>
			</ControlTemplate>
		</Setter>
	</ControlTheme>


	<ControlTheme x:Key="HelixTitleBar2"
				TargetType="{x:Type rcui:TitleBar2}"
				BasedOn="{StaticResource {x:Type rcui:TitleBar2}}">
		<Setter Property="RenderTransform" Value="rotate(45deg)" />
		<Style Selector="^ /template/ rcui|CaptionButtons2#PART_CaptionButtons">
            <Setter Property="Theme" Value="{DynamicResource HelixCaptionButtons2}" />
        </Style>
	</ControlTheme>


	<ControlTheme x:Key="HelixCaptionButtons2"
				TargetType="{x:Type rcui:CaptionButtons2}"
				BasedOn="{StaticResource {x:Type rcui:CaptionButtons2}}">
		<Style Selector="^ /template/ DockPanel#LayoutRoot > ItemsControl">
            <Setter Property="Theme" Value="{DynamicResource HelixCaptionButtonsItemsControl}" />
        </Style>


		<!--
		<Style Selector="^ /template/ ItemsControl#PART_LeftButtons /template/ rcui|AngledBorderEx#BgElement">
			<Setter Property="TopLeftCut" Value="9" />
			<Setter Property="BottomRightCut" Value="{Binding $self.Bounds.Height, Mode=OneWay}" />
		</Style>
		<Style Selector="^ /template/ ItemsControl#PART_RightButtons /template/ rcui|AngledBorderEx#BgElement">
			<Setter Property="TopRightCut" Value="9" />
			<Setter Property="BottomLeftCut" Value="{Binding $self.Bounds.Height, Mode=OneWay}" />
		</Style>
		-->
	</ControlTheme>


	<ControlTheme x:Key="HelixTitleBarUnderlay"
				  TargetType="{x:Type rcui:TitleBarUnderlay}"
                  BasedOn="{StaticResource {x:Type rcui:TitleBarUnderlay}}">
		
		<Style Selector="^ /template/ :is(rcui|AngledBorderBase).activateColoration">
			<Setter Property="Background" Value="{DynamicResource HelixWindow.TitleBar.BackgroundBrush.Active}" />
		</Style>

		<Style Selector="^[IsWindowActive=False]">
			<Style Selector="^ /template/ :is(rcui|AngledBorderBase).activateColoration">
				<Setter Property="Background" Value="{DynamicResource HelixWindow.TitleBar.BackgroundBrush.Inactive}" />
			</Style>
		</Style>


		<!--
		<Style Selector="^ /template/ rcui|AngledBorderEx.caption-buttons-frame">
			<Setter Property="IsVisible" Value="True" />
		</Style>


		<Style Selector="^ /template/ rcui|AngledBorderEx#LeftCaptionButtonsFrame">
			<Setter Property="TopLeftCut" Value="9" />
			<Setter Property="BottomRightCut" Value="{Binding $self.Bounds.Height, Mode=OneWay}" />
		</Style>
		<Style Selector="^ /template/ rcui|AngledBorderEx#RightCaptionButtonsFrame">
			<Setter Property="TopRightCut" Value="9" />
			<Setter Property="BottomLeftCut" Value="{Binding $self.Bounds.Height, Mode=OneWay}" />
		</Style>


		<Style Selector="^[IsWindowMaximizedOrFullScreen=True]">
			<Style Selector="^ /template/ rcui|AngledBorderEx#LeftCaptionButtonsFrame">
				<Setter Property="TopLeftCut" Value="0" />
			</Style>
			<Style Selector="^ /template/ rcui|AngledBorderEx#RightCaptionButtonsFrame">
				<Setter Property="TopRightCut" Value="0" />
			</Style>
		</Style>
		-->
	</ControlTheme>
</ResourceDictionary>