<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<LinearGradientBrush x:Key="GroupBox.Header.Background"
						StartPoint="0%,0%"
						EndPoint="0%,100%">
		<GradientStop Offset="0" Color="#4BB7CFDA" />
		<GradientStop Offset="1" Color="#3293A5AD" />
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="GroupBox.Header.BorderBrush"
						StartPoint="0%,-100%"
						EndPoint="0%,200%">
		<GradientStop Offset="0" Color="#1AFFFFFF" />
		<GradientStop Offset="0.5" Color="#33FFFFFF" />
	</LinearGradientBrush>

	<LinearGradientBrush x:Key="GroupBox.Body.BorderBrush"
						StartPoint="0%,22.8%"
						EndPoint="0%,100%">
		<GradientStop Offset="0" Color="#2EFFFFFF" />
		<GradientStop Offset="1" Color="#17FFFFFF" />
	</LinearGradientBrush>
</ResourceDictionary>