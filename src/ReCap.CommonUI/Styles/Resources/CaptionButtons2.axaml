<ResourceDictionary xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<PathGeometry x:Key="CaptionButtons.GlyphGeometry.Minimize">
		M 0 0 L 13 0 L 13 4 L 0 4 Z
	</PathGeometry>
	<PathGeometry x:Key="CaptionButtons.GlyphGeometry.Maximize">
		M 0 0 V 9 H 11 V 0 Z
		M 2 2 H 9 V 7 H 2 Z
		<!--
		M 0 -1 V 8 H 11 V -1 Z
		M 2 1 H 9 V 6 H 2 Z

		M 0 8 H 11 V -1 H 0 Z
		M 2 1 H 9 V 6 H 2 Z
		-->
	</PathGeometry>
	<PathGeometry x:Key="CaptionButtons.GlyphGeometry.Restore">
		M 0 3 V 9 H 8 V 3 Z
		M 2 5 H 6 V 7 H 2 Z
		M 3 0 H 11 V 6 H 9 V 2 H 3 Z
		<!--
		M 0 3 V 9 H 8 V 3 Z
		M 2 5 H 6 V 7 H 2 Z
		M 2 0 H 11 V 7 H 9 V 2 H 2 Z
		-->
	</PathGeometry>
	<PathGeometry x:Key="CaptionButtons.GlyphGeometry.FullScreen">
		M 4 2 L 6 0 H 10 V 4 L 8 6 V 2 H 4 Z
		M 1 5 L 3 3 V 7 H 7 L 5 9 H 1 Z
	</PathGeometry>
	<PathGeometry x:Key="CaptionButtons.GlyphGeometry.Close">
		M 0 0 H 3 L 5.5 2.5 L 8 0 H 11
		V 1 L 7.5 4.5 L 11 8 V 9
		H 8 L 5.5 6.5 L 3 9 H 0
		V 8 L 3.5 4.5 L 0 1 Z
		<!--
		M 0 0 L 3 0 L 5 2 L 7 0 L 10 0
		L 10 0.5 L 7 4.5 L 10 8.5 L 10 9
		L 7 9 L 5 7 L 3 9 L 0 9
		L 0 8.5 L 3 4.5 L 0 0.5 Z
		-->
	</PathGeometry>
</ResourceDictionary>