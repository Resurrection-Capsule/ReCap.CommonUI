<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>netstandard2.0</TargetFramework>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<PackageId>ReCap.CommonUI</PackageId>
		<Description>Shared Avalonia controls, styles, theme and fonts for ReCap desktop applications (Hub, tools).</Description>
		<PackageTags>avalonia;ui;controls;theme;recap;darkspore</PackageTags>
	</PropertyGroup>
	
	<Import Project="../../build/avalonia.props" />
	
	<ItemGroup>
		<AvaloniaResource Include="Styles/**/*.axaml" />
		<AvaloniaResource Include="Assets/**/*.png" />
		<AvaloniaResource Include="Assets/**/*.ttf" />
	</ItemGroup>
	
	<Import Project="../../build/editorconfig.props" />
</Project>