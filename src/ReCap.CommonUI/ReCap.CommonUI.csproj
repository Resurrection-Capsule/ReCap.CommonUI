<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>netstandard2.0</TargetFramework>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<PackageId>ReCap.CommonUI</PackageId>
		<Description>Shared Avalonia controls, styles, theme and fonts for ReCap desktop applications (Hub, tools).</Description>
		<PackageTags>avalonia;ui;controls;theme;recap;darkspore</PackageTags>
	</PropertyGroup>
	
	<Import Project="../../build/avalonia.props" />
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.Ini" Version="10.0.5" />
		<PackageReference Include="System.Drawing.Common" Version="5.0.0" />
	</ItemGroup>
	
	<ItemGroup>
		<AvaloniaResource Include="Styles/**/*.axaml" />
		<AvaloniaResource Include="Assets/**/*.png" />
		<AvaloniaResource Include="Assets/**/*.ttf" />
	</ItemGroup>
	
	<Import Project="../../build/editorconfig.props" />

	<PropertyGroup>
		<DefineConstants>$(DefineConstants);WINDOWS_USE_SETWINDOWCOMPOSITIONATTRIBUTE;TITLEBAR2_CAPTIONBUTTONS;SEPARATE_INSET_PROPERTIES</DefineConstants>
	</PropertyGroup>
</Project>